#!/usr/bin/env bash
set -e

ROOT="$(cd "$(dirname "$0")" && pwd)"
API="$ROOT/api"
FRONTEND="$ROOT/frontend"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

SAIL="$API/vendor/bin/sail"

log()  { echo -e "${CYAN}[testApp]${NC} $1"; }
ok()   { echo -e "${GREEN}  ✓${NC} $1"; }
warn() { echo -e "${YELLOW}  ⚠${NC} $1"; }
fail() { echo -e "${RED}  ✗${NC} $1"; exit 1; }

# --------------------------------------------------
# 1. Pre-flight checks
# --------------------------------------------------
log "Verifications..."

command -v docker >/dev/null 2>&1 || fail "Docker n'est pas installe"
docker info >/dev/null 2>&1     || fail "Docker n'est pas demarre"
[ -f "$SAIL" ]                  || fail "Sail introuvable — lance 'composer install' dans api/"
[ -f "$API/.env" ]              || { cp "$API/.env.example" "$API/.env"; warn ".env cree depuis .env.example — pense a le configurer"; }
command -v node >/dev/null 2>&1 || fail "Node.js n'est pas installe"

ok "Prerequis OK"

# --------------------------------------------------
# 2. Install deps if missing
# --------------------------------------------------
if [ ! -d "$API/vendor" ]; then
    log "Installation des dependances backend..."
    docker run --rm -u "$(id -u):$(id -g)" \
        -v "$API:/var/www/html" -w /var/www/html \
        laravelsail/php84-composer:latest \
        composer install --ignore-platform-reqs --quiet
    ok "composer install"
fi

if [ ! -d "$FRONTEND/node_modules" ]; then
    log "Installation des dependances frontend..."
    (cd "$FRONTEND" && npm install --silent)
    ok "npm install"
fi

# --------------------------------------------------
# 3. Start Sail
# --------------------------------------------------
log "Demarrage des containers..."

cd "$API"

if $SAIL ps --status running 2>/dev/null | grep -q "laravel.test"; then
    ok "Containers deja en marche"
else
    $SAIL up -d
    ok "Containers demarres"
fi

# --------------------------------------------------
# 4. Wait for MySQL
# --------------------------------------------------
log "Attente de MySQL..."

for i in $(seq 1 30); do
    status=$(docker inspect --format='{{.State.Health.Status}}' api-mysql-1 2>/dev/null || echo "waiting")
    [ "$status" = "healthy" ] && break
    sleep 2
done

[ "$status" = "healthy" ] && ok "MySQL pret" || fail "MySQL ne repond pas apres 60s"

# --------------------------------------------------
# 5. Migrations
# --------------------------------------------------
log "Migrations..."
$SAIL artisan migrate --force --quiet
ok "Base de donnees a jour"

# --------------------------------------------------
# 6. Generate APP_KEY if missing
# --------------------------------------------------
if grep -q "^APP_KEY=$" "$API/.env" 2>/dev/null; then
    $SAIL artisan key:generate --quiet
    ok "APP_KEY generee"
fi

# --------------------------------------------------
# 7. Start frontend dev server
# --------------------------------------------------
log "Demarrage du frontend..."

cd "$FRONTEND"
npm run dev &
VITE_PID=$!

# --------------------------------------------------
# 8. Summary
# --------------------------------------------------
echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}  testApp est pret !${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo -e "  API      ${CYAN}http://localhost:\${APP_PORT:-8080}${NC}"
echo -e "  Frontend ${CYAN}http://localhost:5173${NC}"
echo -e "  MySQL    ${CYAN}localhost:\${FORWARD_DB_PORT:-3307}${NC}"
echo -e "  Redis    ${CYAN}localhost:6379${NC}"
echo ""
echo -e "  ${YELLOW}Ctrl+C${NC} pour arreter le frontend"
echo -e "  ${YELLOW}cd api && ./vendor/bin/sail down${NC} pour arreter les containers"
echo ""

# Keep script alive until Ctrl+C
trap "kill $VITE_PID 2>/dev/null; echo ''; log 'Frontend arrete. Les containers Sail tournent encore.'; exit 0" INT TERM
wait $VITE_PID
